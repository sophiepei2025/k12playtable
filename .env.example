# ======================= LLM =======================
# MVP 默认：千问中国（北京）。以后切美国，只改这里，不用改代码。
LLM_PROVIDER=qwen-cn            # qwen-cn | qwen-us | qwen-intl | ark | deepseek

# 千问中国（北京）key：百炼控制台 → API-KEY（华北2 北京）
DASHSCOPE_API_KEY_CN=

# 千问美国（弗吉尼亚）key：预留。切换方法：
#   1) 填 DASHSCOPE_API_KEY_US
#   2) LLM_PROVIDER=qwen-us
#   3) 删掉下面的 LLM_ALLOW_FAMILY_DATA_ON
DASHSCOPE_API_KEY_US=

# MVP 阶段允许「一句话搜索」把家长输入（可能含年级、城市）发到 qwen-cn。
# 不设置时，含家庭信息的请求不会发到中国大陆节点，自动改用规则解析。
LLM_ALLOW_FAMILY_DATA_ON=qwen-cn

# 可选：按任务覆盖模型（默认见 src/core/llm.ts）
# LLM_MODEL_NL_SEARCH=qwen3.7-flash
# LLM_MODEL_EXTRACT=qwen-flash
# LLM_MODEL_PLAN=qwen3.7-plus

# 备用（只处理公开数据）
# ARK_API_KEY=
# DEEPSEEK_API_KEY=

# ======================= MCP =======================
# 付费 tool（check_conflicts, get_deadlines）用 Authorization: Bearer <token> 解锁，逗号分隔
PAID_ACCESS_TOKENS=
PORT=3333

# ==================== 纠错渠道 =====================
ISSUES_REPO=                    # 例如 sophiepei2025/edmoat-extracurriculars
FEEDBACK_EMAIL=
