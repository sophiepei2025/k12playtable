# ---- LLM (Qwen by default) ----
# US (Virginia) key from Alibaba Cloud Model Studio → Key Management (Virginia).
# Calls go to dashscope-us.aliyuncs.com (US deployment scope; data stays in the US).
DASHSCOPE_API_KEY=
LLM_PROVIDER=qwen-us            # qwen-us | qwen-intl | ark | deepseek
# Optional per-task model overrides (defaults in src/core/llm.ts)
# LLM_MODEL_NL_SEARCH=qwen3.7-flash
# LLM_MODEL_EXTRACT=qwen-flash
# LLM_MODEL_PLAN=qwen3.7-plus
# Backups (public data only, never family data)
# ARK_API_KEY=
# DEEPSEEK_API_KEY=

# ---- MCP ----
# Paid tools (check_conflicts, get_deadlines) unlock with Authorization: Bearer <token>.
# Comma-separated. Stopgap until per-family OAuth 2.1.
PAID_ACCESS_TOKENS=
PORT=3333

# ---- Data issue reports ----
ISSUES_REPO=                    # e.g. sophiepei2025/edmoat-extracurriculars
FEEDBACK_EMAIL=
