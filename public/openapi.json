{
  "openapi": "3.1.0",
  "info": {
    "title": "Extracurricular Finder API",
    "version": "0.1.0",
    "description": "Read-only. null fields are not verified yet."
  },
  "paths": {
    "/api/activities": {
      "get": {
        "operationId": "searchActivities",
        "summary": "Search activities or get one by id",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Keywords"
          },
          {
            "name": "audience",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma list: high_school,undergraduate,graduate"
          },
          {
            "name": "grade",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "9-12"
          },
          {
            "name": "subjects",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Comma list, any-match"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Program,Competition,Academic Research,Community Service,Club"
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "in_person,hybrid,online"
          },
          {
            "name": "commitment",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "short_term|long_term"
          },
          {
            "name": "organizer_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "company,nonprofit,university_program,education_org,government"
          },
          {
            "name": "big_company",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": ""
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "US,CA,Global"
          },
          {
            "name": "fee",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "free|paid (verified only)"
          },
          {
            "name": "max_cost",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            },
            "description": "Verified cost at or below"
          },
          {
            "name": "deadline_month",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "1-12"
          },
          {
            "name": "international_ok",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": ""
          },
          {
            "name": "selective_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": ""
          },
          {
            "name": "verified_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": ""
          },
          {
            "name": "include_discontinued",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            },
            "description": ""
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "relevance|signal|deadline|name"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": "1-200, default 20"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            },
            "description": ""
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Return one activity instead of searching"
          }
        ],
        "responses": {
          "200": {
            "description": "SearchResult {total, offset, limit, results[]} or {activity, signals} when id is given"
          }
        }
      }
    },
    "/api/parse-query": {
      "post": {
        "operationId": "parseQuery",
        "summary": "Turn a plain-language request into search filters",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "maxLength": 400
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "{filters, source: llm|fallback}"
          }
        }
      }
    }
  }
}